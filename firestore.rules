rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Authentication & User Profile
    // ─────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function activeUser() {
      return signedIn()
        && profile().data.isActive == true
        && profile().data.farmId is string
        && profile().data.farmId.size() > 0;
    }

    function userRole() {
      return profile().data.role;
    }

    // ─────────────────────────────────────────────
    // Role Permissions
    // ─────────────────────────────────────────────

    function canRead() {
      return activeUser()
        && (
          userRole() == 'owner' ||
          userRole() == 'admin' ||
          userRole() == 'manager' ||
          userRole() == 'staff'
        );
    }

    function canCreate() {
      return activeUser()
        && (
          userRole() == 'owner' ||
          userRole() == 'admin' ||
          userRole() == 'manager' ||
          userRole() == 'staff'
        );
    }

    function canUpdate() {
      return activeUser()
        && (
          userRole() == 'owner' ||
          userRole() == 'admin' ||
          userRole() == 'manager'
        );
    }

    function canDelete() {
      return activeUser()
        && (
          userRole() == 'owner' ||
          userRole() == 'admin' ||
          userRole() == 'manager'
        );
    }

    // ─────────────────────────────────────────────
    // Farm Isolation
    // ─────────────────────────────────────────────

    function sameFarm(data) {
      return activeUser()
        && data.farmId == profile().data.farmId;
    }

    // ─────────────────────────────────────────────
    // Record Validation
    // ─────────────────────────────────────────────

    function validNewRecord() {
      return sameFarm(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
    }

    function validUpdate() {
      return sameFarm(resource.data)
        && sameFarm(request.resource.data)
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // ─────────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────────

    match /users/{uid} {

      // User can read only their own profile.
      allow read: if signedIn()
        && request.auth.uid == uid;

      // Client application cannot create, modify,
      // or delete user profiles.
      //
      // User provisioning must happen through
      // Admin SDK / Firebase Console.
      allow create, update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // Animals
    // ─────────────────────────────────────────────

    match /animals/{id} {

      allow read: if canRead()
        && sameFarm(resource.data);

      allow create: if canCreate()
        && validNewRecord();

      allow update: if canUpdate()
        && validUpdate();

      allow delete: if canDelete()
        && sameFarm(resource.data);
    }

    // ─────────────────────────────────────────────
    // Milk Records
    // ─────────────────────────────────────────────

    match /milk_records/{id} {

      allow read: if canRead()
        && sameFarm(resource.data);

      allow create: if canCreate()
        && validNewRecord();

      allow update: if canUpdate()
        && validUpdate();

      allow delete: if canDelete()
        && sameFarm(resource.data);
    }

    // ─────────────────────────────────────────────
    // Expenses
    // ─────────────────────────────────────────────

    match /expenses/{id} {

      allow read: if canRead()
        && sameFarm(resource.data);

      allow create: if canCreate()
        && validNewRecord();

      allow update: if canUpdate()
        && validUpdate();

      allow delete: if canDelete()
        && sameFarm(resource.data);
    }

    // ─────────────────────────────────────────────
    // Health Records
    // ─────────────────────────────────────────────

    match /health_records/{id} {

      allow read: if canRead()
        && sameFarm(resource.data);

      allow create: if canCreate()
        && validNewRecord();

      allow update: if canUpdate()
        && validUpdate();

      allow delete: if canDelete()
        && sameFarm(resource.data);
    }

    // ─────────────────────────────────────────────
    // Inventory
    // ─────────────────────────────────────────────

    match /inventory/{id} {

      allow read: if canRead()
        && sameFarm(resource.data);

      allow create: if canCreate()
        && validNewRecord();

      allow update: if canUpdate()
        && validUpdate();

      allow delete: if canDelete()
        && sameFarm(resource.data);
    }

    // ─────────────────────────────────────────────
    // Pregnancy Records
    // ─────────────────────────────────────────────

    match /pregnancy_records/{id} {

      allow read: if canRead()
        && sameFarm(resource.data);

      allow create: if canCreate()
        && validNewRecord();

      allow update: if canUpdate()
        && validUpdate();

      allow delete: if canDelete()
        && sameFarm(resource.data);
    }

    // ─────────────────────────────────────────────
    // Audit Logs
    // ─────────────────────────────────────────────

    match /audit_logs/{id} {

      // Audit history can be viewed only
      // by active users of the same farm.
      allow read: if canRead()
        && sameFarm(resource.data);

      // Any active role may create an audit entry,
      // but only for themselves and their own farm.
      allow create: if canCreate()
        && validNewRecord()
        && request.resource.data.userId == request.auth.uid;

      // Audit history must never be modified/deleted
      // from the client.
      allow update, delete: if false;
    }
  }
}